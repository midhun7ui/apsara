{"messages": [{"role": "user", "content": "Can I reserve a seat for my friend?"}, {"role": "assistant", "content": "That depends on the app's booking rules. Check whether your account can book multiple seats and make sure the correct number of seats is selected."}]}
{"messages": [{"role": "user", "content": "What information do you need to search for a ride?"}, {"role": "assistant", "content": "Please provide your pickup location, destination, travel date, and preferred departure time. I can then help search for matching rides."}]}
